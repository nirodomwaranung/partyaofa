{
  "name": "party-aofa",
  "private": true,
  "version": "0.1.0",
  "description": "Party AOFA — corporate party game platform (Nuxt 4 + NestJS + PostgreSQL + Socket.IO)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace apps/api",
    "db:seed": "npm run prisma:seed --workspace apps/api",
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "vue-demi@0.14.10": true
  }
}

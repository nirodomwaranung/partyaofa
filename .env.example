# ============================================================
#  LOCAL DEV (PostgreSQL via docker-compose / brew)
# ============================================================
POSTGRES_USER=aofa
POSTGRES_PASSWORD=aofa_secret
POSTGRES_DB=party_aofa
POSTGRES_PORT=5432

# Prisma connection (used by apps/api)
DATABASE_URL="postgresql://aofa:aofa_secret@localhost:5432/party_aofa?schema=public"
# Direct connection for `prisma migrate` (local: same as DATABASE_URL)
DIRECT_URL="postgresql://aofa:aofa_secret@localhost:5432/party_aofa?schema=public"

# ============================================================
#  SUPABASE (production) — fill from Dashboard, then swap the
#  two URLs above for these. Project ref: madppayyvvhvvjlltoma
# ============================================================

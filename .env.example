# ============================================================
#  Party AOFA — single .env for the whole VPS stack
#  (Postgres + API + Web). Copy to .env and fill values.
# ============================================================

# ---- PostgreSQL (runs in the db container) ----
POSTGRES_USER=aofa
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=party_aofa

# Prisma connects to the db service over the docker network.
DATABASE_URL="postgresql://aofa:change-this-db-password@db:5432/party_aofa?schema=public"
DIRECT_URL="postgresql://aofa:change-this-db-password@db:5432/party_aofa?schema=public"

# ---- API (NestJS) ----
API_PORT=3001
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=aofa2026
CORS_ORIGIN="https://aofa.cloud,https://www.aofa.cloud"
# public base used to build image URLs (uploaded avatars/covers)
PUBLIC_API_BASE="https://api.aofa.cloud"
UPLOAD_DIR=/app/uploads

# ---- Web (Nuxt) — read at runtime by the web container ----
NUXT_PUBLIC_API_BASE="https://api.aofa.cloud"
NUXT_PUBLIC_SOCKET_URL="https://api.aofa.cloud"

# ============================================================
#  LOCAL DEV (no Docker) — uncomment + use a local Postgres:
# DATABASE_URL="postgresql://aofa:aofa_secret@localhost:5432/party_aofa?schema=public"
# DIRECT_URL="postgresql://aofa:aofa_secret@localhost:5432/party_aofa?schema=public"
# CORS_ORIGIN=http://localhost:3000
# PUBLIC_API_BASE=http://localhost:3001
# UPLOAD_DIR=
# NUXT_PUBLIC_API_BASE=http://localhost:3001
# NUXT_PUBLIC_SOCKET_URL=http://localhost:3001
# ============================================================
